# ==============================================================================
# LLM ANALYST LAYER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.template .env
#
# Support:
# 1. Google AI Studio (Gemini Free Tier / Paid)
# 2. OpenRouter (Free Tier / Paid models: DeepSeek, Llama, Gemini, Qwen, etc.)
# ==============================================================================

# Active LLM Provider: 'google' or 'openrouter'
LLM_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 1. Google AI Studio Configuration
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Alternative Google models: gemini-2.5-pro, gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. OpenRouter Configuration
# Get your key at: https://openrouter.ai/keys
# OpenRouter offers free models with suffix ':free'
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Suggested Free Models on OpenRouter:
# - deepseek/deepseek-r1:free (Deep reasoning / Macro breakdown)
# - google/gemini-2.0-flash-exp:free (Fast, high context window)
# - meta-llama/llama-3.3-70b-instruct:free (Strong analytical writing)
# - qwen/qwen-2.5-72b-instruct:free
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# ------------------------------------------------------------------------------
# 3. Analyst Output & Timezone Settings
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Ho_Chi_Minh
REPORTS_DIR=reports
