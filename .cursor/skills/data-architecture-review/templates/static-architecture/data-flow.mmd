%% Local evidence placeholder; syntax based on Mermaid flowchart documentation (MIT): https://github.com/mermaid-js/mermaid
%% Show stable blocks and named interfaces, not every implementation detail.
flowchart LR
    source[Source system]
    ingest[Ingestion block]
    store[(Data store)]
    consumer[Consumer block]
    source -->|[contract / topic / file]| ingest
    ingest -->|[dataset / table / event]| store
    store -->|[query / contract]| consumer
